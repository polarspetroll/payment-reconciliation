//RECONZX JOB 1,NOTIFY=&SYSUID,MSGCLASS=H
//* z xplore version. datasets are capped at 200kb there so the
//* ledgers live as z/os unix files. step 1 sorts them with the
//* unix sort (dfsort cant read unix files), step 2 is RECON
//SORT EXEC PGM=BPXBATCH
//STDOUT DD SYSOUT=*
//STDERR DD SYSOUT=*
//STDPARM DD *
SH cd /z/z68330 && rm -f MATCHED UNMATCHA UNMATCHB MISMATCH &&
 sort -k1.75,1.90 -k1.11,1.18 -k1.1,1.10 LEDGERA.txt >LEDGERA.srt &&
 sort -k1.75,1.90 -k1.11,1.18 -k1.1,1.10 LEDGERB.txt >LEDGERB.srt
/*
//RECON EXEC PGM=RECON
//STEPLIB DD DSN=&SYSUID..LOAD,DISP=SHR
//LEDGERA DD PATH='/z/z68330/LEDGERA.srt',PATHOPTS=(ORDONLY),
// FILEDATA=TEXT,RECFM=FB,LRECL=100,BLKSIZE=100
//LEDGERB DD PATH='/z/z68330/LEDGERB.srt',PATHOPTS=(ORDONLY),
// FILEDATA=TEXT,RECFM=FB,LRECL=100,BLKSIZE=100
//MATCHED DD PATH='/z/z68330/MATCHED',PATHMODE=(SIRUSR,SIWUSR),
// PATHOPTS=(OWRONLY,OCREAT,OTRUNC),
// FILEDATA=TEXT,RECFM=FB,LRECL=80,BLKSIZE=80
//UNMATCHA DD PATH='/z/z68330/UNMATCHA',PATHMODE=(SIRUSR,SIWUSR),
// PATHOPTS=(OWRONLY,OCREAT,OTRUNC),
// FILEDATA=TEXT,RECFM=FB,LRECL=100,BLKSIZE=100
//UNMATCHB DD PATH='/z/z68330/UNMATCHB',PATHMODE=(SIRUSR,SIWUSR),
// PATHOPTS=(OWRONLY,OCREAT,OTRUNC),
// FILEDATA=TEXT,RECFM=FB,LRECL=100,BLKSIZE=100
//MISMATCH DD PATH='/z/z68330/MISMATCH',PATHMODE=(SIRUSR,SIWUSR),
// PATHOPTS=(OWRONLY,OCREAT,OTRUNC),
// FILEDATA=TEXT,RECFM=FB,LRECL=101,BLKSIZE=101
//SYSOUT DD SYSOUT=*
