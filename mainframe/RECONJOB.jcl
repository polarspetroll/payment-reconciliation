//RECONJOB JOB 1,NOTIFY=&SYSUID,MSGCLASS=H
//* step 0 clean up old outputs so reruns dont fail with dup dataset
//CLEANUP  EXEC PGM=IEFBR14
//DD1      DD DSN=&SYSUID..RECON.LEDGERA.SORTED,
//            DISP=(MOD,DELETE,DELETE),SPACE=(TRK,(1,1)),UNIT=SYSDA
//DD2      DD DSN=&SYSUID..RECON.LEDGERB.SORTED,
//            DISP=(MOD,DELETE,DELETE),SPACE=(TRK,(1,1)),UNIT=SYSDA
//DD3      DD DSN=&SYSUID..RECON.MATCHED,
//            DISP=(MOD,DELETE,DELETE),SPACE=(TRK,(1,1)),UNIT=SYSDA
//DD4      DD DSN=&SYSUID..RECON.UNMATCHA,
//            DISP=(MOD,DELETE,DELETE),SPACE=(TRK,(1,1)),UNIT=SYSDA
//DD5      DD DSN=&SYSUID..RECON.UNMATCHB,
//            DISP=(MOD,DELETE,DELETE),SPACE=(TRK,(1,1)),UNIT=SYSDA
//DD6      DD DSN=&SYSUID..RECON.MISMATCH,
//            DISP=(MOD,DELETE,DELETE),SPACE=(TRK,(1,1)),UNIT=SYSDA
//*
//* step 1 dfsort both ledgers by reference, post date, id
//SORTA    EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..RECON.LEDGERA,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..RECON.LEDGERA.SORTED,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(5,5),RLSE),DCB=(RECFM=FB,LRECL=100)
//SYSIN    DD *
  SORT FIELDS=(75,16,CH,A,11,8,CH,A,1,10,CH,A)
/*
//SORTB    EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..RECON.LEDGERB,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..RECON.LEDGERB.SORTED,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(5,5),RLSE),DCB=(RECFM=FB,LRECL=100)
//SYSIN    DD *
  SORT FIELDS=(75,16,CH,A,11,8,CH,A,1,10,CH,A)
/*
//*
//* step 2 one pass over both files, v2 rules per reference group
//RECON    EXEC PGM=RECON
//STEPLIB  DD DSN=&SYSUID..LOAD,DISP=SHR
//LEDGERA  DD DSN=&SYSUID..RECON.LEDGERA.SORTED,DISP=SHR
//LEDGERB  DD DSN=&SYSUID..RECON.LEDGERB.SORTED,DISP=SHR
//MATCHED  DD DSN=&SYSUID..RECON.MATCHED,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(3,3),RLSE),DCB=(RECFM=FB,LRECL=80)
//UNMATCHA DD DSN=&SYSUID..RECON.UNMATCHA,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(3,3),RLSE),DCB=(RECFM=FB,LRECL=100)
//UNMATCHB DD DSN=&SYSUID..RECON.UNMATCHB,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(3,3),RLSE),DCB=(RECFM=FB,LRECL=100)
//MISMATCH DD DSN=&SYSUID..RECON.MISMATCH,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(3,3),RLSE),DCB=(RECFM=FB,LRECL=101)
//SYSOUT   DD SYSOUT=*
