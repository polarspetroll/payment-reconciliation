// measures on table v_recon_bi (sql/05_powerbi_views.sql)
// matched records are rolled up, so counts use record_count not COUNTROWS

Total Records =
SUM ( v_recon_bi[record_count] )

Exception Count =
CALCULATE ( SUM ( v_recon_bi[record_count] ), v_recon_bi[status] = "EXCEPTION" )

// card shows this one, the new card visual shortens numbers to 2K otherwise
Exceptions =
FORMAT ( [Exception Count], "#,0" )

Exception Rate =
DIVIDE ( [Exception Count], [Total Records] )

$ At Risk =
CALCULATE ( SUM ( v_recon_bi[amount_cad] ), v_recon_bi[status] = "EXCEPTION" )

Open Exceptions =
CALCULATE ( SUM ( v_recon_bi[record_count] ), v_recon_bi[exception_status] = "Open" )
